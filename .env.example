# Copy to `.env` in this folder, then `chmod 600 .env`. Never commit it.
#
# Any value can instead read from the macOS Keychain: write `keychain:<service>`
# and store the secret with
#   security add-generic-password -a "$USER" -s <service> -w '<secret>'
# For example: RESEND_API_KEY_OUTREACH=keychain:jura-growth-resend

# One webhook per channel in the "Jura HQ" Discord server
# (outputs/growth/setup/discord.md walks through creating them).
DISCORD_WEBHOOK_DAILY_DIGEST=
DISCORD_WEBHOOK_SCOUT_LEADS=
DISCORD_WEBHOOK_OUTREACH_SENT=
DISCORD_WEBHOOK_OUTREACH_REPLIES=
DISCORD_WEBHOOK_APP_FACTORY=
DISCORD_WEBHOOK_SOCIAL_DRAFTS=
DISCORD_WEBHOOK_COMMUNITY=
DISCORD_WEBHOOK_ALERTS=
# Approval cards. Without it no card is posted, and every gated action waits until its request lapses.
DISCORD_WEBHOOK_APPROVALS=
# The 08:00 one-pager and its health strip.
DISCORD_WEBHOOK_MISSION_CONTROL=

# Outreach sending. A sending-only Resend key, separate from the website's.
RESEND_API_KEY_OUTREACH=

# Shared with the website (Cloudflare Pages env) so unsubscribe links verify.
UNSUBSCRIBE_SECRET=

# Read access to the website's D1 database (suppression list, app usage).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=

# Read-only IMAP on levi@jurasolutions.sg (the Reply-To and unsubscribe mailbox): reply detection and
# the inbox watch.
OUTREACH_IMAP_HOST=
OUTREACH_IMAP_PORT=993
OUTREACH_IMAP_USER=
OUTREACH_IMAP_PASSWORD=

# Optional second mailbox for the inbox watch: info@jurasolutions.sg, where website enquiries go, if
# it isn't delivered to the mailbox above.
ENQUIRY_IMAP_HOST=
ENQUIRY_IMAP_PORT=993
ENQUIRY_IMAP_USER=
ENQUIRY_IMAP_PASSWORD=

# Ting Yu's Discord user id (digits only). A decision that reaches the Mac
# through Dispatch must name this user. It is a consistency check on the
# attribution; the SSH key and Dispatch's own allowlist are the guard.
CONTROL_DISCORD_USER_ID=
